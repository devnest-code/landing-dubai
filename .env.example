# ── Email (Resend) ──────────────────────────────────────────────
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender domain address (e.g. noreply@yourdomain.com)
LEAD_FROM_EMAIL=DevNest <noreply@example.com>
# Internal inbox that receives new lead notifications
LEAD_TO_EMAIL=devnest.code@gmail.com

# ── Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Analytics ───────────────────────────────────────────────────
# Google Analytics 4 measurement id (G-XXXXXXXXXX). Optional.
NEXT_PUBLIC_GA_ID=

# ── Google Search Console (optional) ────────────────────────────
NEXT_PUBLIC_GOOGLE_VERIFICATION=
